# Salin menjadi .env  (atau cukup jalankan ./start.sh / .\start.ps1 yang membuatnya otomatis)
# JANGAN commit .env berisi key ke GitHub: penyedia API mencabut key yang terlihat publik.
LLM_PROVIDER=openai

# OpenRouter (https://openrouter.ai/settings/keys)
OPENAI_API_KEY=isi_api_key_anda_di_sini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_FALLBACK_MODELS=google/gemini-2.5-flash-lite

# Atau OpenAI langsung: kosongkan OPENAI_BASE_URL & OPENAI_FALLBACK_MODELS, OPENAI_MODEL=gpt-4o-mini
# Atau Groq (gratis): OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
