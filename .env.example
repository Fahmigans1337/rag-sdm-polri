# ============================================================
# RAG SDM POLRI — Konfigurasi Environment
# Salin file ini menjadi ".env" lalu isi nilai yang dibutuhkan
# ============================================================

# ── LLM: Gemini (WAJIB) ─────────────────────────────────────
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model utama yang digunakan
GEMINI_MODEL=gemini-3.5-flash-lite

# Rantai fallback jika model utama overloaded/quota habis
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest

# ── LLM: Alternatif OpenAI-compatible (opsional) ────────────
# Bisa dipakai dengan OpenAI, Groq, OpenRouter, atau Ollama
# OPENAI_API_KEY=your_openai_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ── Retrieval (opsional, ada default) ───────────────────────
# Ambang relevansi BM25 (0.0–1.0, default: 0.42)
# MIN_COVERAGE=0.42

# Jumlah chunk yang diambil per query (default: 6)
# TOP_K=6

# ── LLM Timeout (detik) ─────────────────────────────────────
# LLM_TIMEOUT=25

# ── Chunking (opsional) ─────────────────────────────────────
# CHUNK_SIZE=1100
# CHUNK_OVERLAP=180
